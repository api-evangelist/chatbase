          "name": "Message an agent",
          "request": {
            "name": "Message an agent",
            "description": {
              "content": "Send a message to a chatbot and receive a response. Set stream=true to receive the reply word by word as raw text.",
              "type": "text/plain"
            },
            "url": {
              "path": ["api", "v1", "chat"],
              "host": ["{{baseUrl}}"],
              "query": [],
              "variable": []
            },
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"messages\": [\n    { \"role\": \"user\", \"content\": \"<string>\" }\n  ],\n  \"chatbotId\": \"<string>\",\n  \"conversationId\": \"<string>\",\n  \"stream\": false,\n  \"temperature\": 0\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "response": []
        }
      ]
